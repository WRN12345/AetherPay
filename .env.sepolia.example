# Sepolia 测试网配置模板
# 复制为仓库根目录的 .env.sepolia 后填写；.env.sepolia 不提交到仓库
# 使用方式：APP_ENV_FILE=.env.sepolia uvicorn app.main:app ...（Worker 同理）

# 应用配置
APP_NAME=web3 Payment API (Sepolia)
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL：建议为测试网单独建库，避免与本地 Anvil 的数据混在一起
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USER=web3_app
PGSQL_PASSWORD=change_me
PGSQL_DATABASE=web3_payment_sepolia

# 链与合约
# RPC 地址含有服务商密钥，属于敏感信息
RPC_URL=https://sepolia.infura.io/v3/你的密钥
CHAIN_ID=11155111
# 部署合约后填写合约地址和部署所在的区块号
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=0

# 扫描策略：只处理已最终确定的区块（约落后最新区块 13 分钟），正常情况下不会遇到重组
# 想更快看到结果可改为 safe（约 6 分钟），或 latest 配合 REQUIRED_CONFIRMATIONS
SCAN_BLOCK_TAG=finalized
REQUIRED_CONFIRMATIONS=1
ORDER_TTL_SECONDS=3600
# 免费节点对单次 eth_getLogs 的区块范围有限制
SCAN_BATCH_SIZE=500
# Sepolia 约 12 秒出一个块，轮询太频繁只会浪费节点调用额度
WORKER_POLL_SECONDS=12
WORKER_MAX_BACKOFF_SECONDS=120
HEALTH_MAX_SCAN_LAG_BLOCKS=20

# 钱包签名登录（APP_DOMAIN、APP_URI 必须与浏览器地址栏中的网页地址一致）
APP_DOMAIN=127.0.0.1:5173
APP_URI=http://127.0.0.1:5173
LOGIN_CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
ORDER_CREATE_LIMIT_PER_MINUTE=10
