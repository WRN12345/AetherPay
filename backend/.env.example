# 应用配置
APP_NAME=web3 Payment API
APP_VERSION=0.1.0
DEBUG=false

# 数据库
DATABASE_URL=postgresql+psycopg://web3_app:change_me@127.0.0.1:5432/web3_payment

# 链与合约（部署合约后填写 CONTRACT_ADDRESS 和 DEPLOYMENT_BLOCK）
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=0

# 业务与扫描参数
REQUIRED_CONFIRMATIONS=1
ORDER_TTL_SECONDS=1800
SCAN_BATCH_SIZE=500
WORKER_POLL_SECONDS=3
