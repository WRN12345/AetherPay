# 复制为仓库根目录的 .env 后按实际情况填写；.env 不提交到仓库

# 应用配置
APP_NAME=web3 Payment API
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL 配置
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USER=web3_app
PGSQL_PASSWORD=change_me
PGSQL_DATABASE=web3_payment

# 链与合约（部署合约后填写 CONTRACT_ADDRESS 和 DEPLOYMENT_BLOCK）
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=0

# 业务与扫描参数
REQUIRED_CONFIRMATIONS=1
ORDER_TTL_SECONDS=1800
SCAN_BATCH_SIZE=500
WORKER_POLL_SECONDS=3
WORKER_MAX_BACKOFF_SECONDS=60
HEALTH_MAX_SCAN_LAG_BLOCKS=20

# 钱包签名登录（APP_DOMAIN、APP_URI 必须与浏览器地址栏中的网页地址一致）
APP_DOMAIN=127.0.0.1:5173
APP_URI=http://127.0.0.1:5173
LOGIN_CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
ORDER_CREATE_LIMIT_PER_MINUTE=10
