# 复制为仓库根目录的 .env 后按实际情况填写；.env 不提交到仓库

# 应用配置
APP_NAME=web3 Payment API
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL 配置
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USER=web3_app
PGSQL_PASSWORD=change_me
PGSQL_DATABASE=web3_payment

# 链与合约（部署合约后填写 CONTRACT_ADDRESS 和 DEPLOYMENT_BLOCK）
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=0

# 业务与扫描参数
REQUIRED_CONFIRMATIONS=1
ORDER_TTL_SECONDS=1800
SCAN_BATCH_SIZE=500
WORKER_POLL_SECONDS=3
